# Base y autenticacion: Supabase. La secret key es de acceso total: solo servidor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Archivos: Cloudflare R2 (bucket publico).
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_PUBLIC_URL=https://pub-xxx.r2.dev
R2_BUCKET=hancel-media
SERPER_API_KEY=xxx
INGEST_SECRET=<openssl rand -hex 32>

# Rutina de analisis de Claude Code (sin el prefijo "Bearer" en el token).
ANALYSIS_ROUTINE_URL=https://api.anthropic.com/v1/claude_code/routines/<trigger-id>/fire
ANALYSIS_ROUTINE_TOKEN=sk-ant-oat01-xxx

# Rutinas de la etapa 2 (generacion de contenido). Sin el prefijo "Bearer".
ANGLE_ROUTINE_URL=https://api.anthropic.com/v1/claude_code/routines/<trigger-id>/fire
ANGLE_ROUTINE_TOKEN=sk-ant-oat01-xxx
LINKEDIN_ROUTINE_URL=https://api.anthropic.com/v1/claude_code/routines/<trigger-id>/fire
LINKEDIN_ROUTINE_TOKEN=sk-ant-oat01-xxx

# Publicacion en LinkedIn. El redirect debe estar dado de alta en la app de
# LinkedIn Developers, tal cual, incluido el https.
LINKEDIN_CLIENT_ID=xxx
LINKEDIN_CLIENT_SECRET=xxx
LINKEDIN_REDIRECT_URI=https://<host>/api/auth/linkedin/callback
INSTAGRAM_ROUTINE_URL=…/routines/<id>/fire    # etapa 2: carrusel
INSTAGRAM_ROUTINE_TOKEN=sk-ant-oat01-xxx

# Banco de fotos del carrusel de Instagram.
PEXELS_API_KEY=xxx

# Publicacion en Instagram a traves de Buffer.
BUFFER_API_KEY=xxx
